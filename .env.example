# ---- MyDoc environment configuration ------------------------------------
# Copy this file to `.env` and adjust the values for your environment.
# NEVER commit the real `.env` file to version control.

# Application environment: development | production | testing
FLASK_ENV=development
FLASK_DEBUG=1

# Secret key used to sign sessions and CSRF tokens (REQUIRED in production).
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Database URL. SQLite by default; swap to PostgreSQL by changing the URL, e.g.
#   postgresql+psycopg2://user:password@localhost:5432/mydoc
DATABASE_URL=sqlite:///mydoc.db

# Session / cookie security
SESSION_COOKIE_SECURE=0          # 1 in production (HTTPS only)
REMEMBER_COOKIE_SECURE=0         # 1 in production (HTTPS only)
SESSION_COOKIE_SAMESITE=Lax

# Rate limiting (Flask-Limiter storage). Use redis:// in production.
RATELIMIT_STORAGE_URL=memory://
RATELIMIT_ENABLED=1

# Uploads
MAX_UPLOAD_MB=4

# Mailer: "console" prints mails to the terminal (development default).
# Set MAIL_SUPPRESS_SEND=0 and the SMTP_* values to actually send e-mail.
MAIL_PROVIDER=console
MAIL_SUPPRESS_SEND=1
MAIL_FROM=noreply@mydoc.local
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=1

# Public base URL used to build links inside e-mails.
SITE_URL=http://127.0.0.1:5000

# Optional: paths for Gunicorn/Nginx deployments are documented in README.md.
